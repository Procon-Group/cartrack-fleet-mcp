{
  "name": "cartrack-fleet-mcp",
  "version": "0.1.0",
  "description": "MCP server wrapping Cartrack's Fleet API for Procon Fleet, plus CLI sync scripts for the daily Google Sheet dashboard and monthly fleet-card reconciliation.",
  "type": "module",
  "private": true,
  "bin": {
    "cartrack-fleet-mcp": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "sync:daily": "node dist/scripts/syncDaily.js",
    "sync:monthly": "node dist/scripts/syncMonthly.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "exceljs": "^4.4.0",
    "googleapis": "^144.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
