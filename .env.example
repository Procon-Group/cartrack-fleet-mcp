# Cartrack Fleet API (developer.cartrack.com) — HTTP Basic Auth.
# Generate credentials in Fleetweb -> Settings -> API Settings.
CARTRACK_USERNAME=
CARTRACK_PASSWORD=
# Region-specific host. Confirmed from Cartrack's own docs (base-url page): Namibia has
# its own country code "na", not South Africa's — https://fleetapi-<cc>.cartrack.com/rest.
CARTRACK_BASE_URL=https://fleetapi-na.cartrack.com/rest

# Google Sheets/Drive — service account (Sheets + Drive API), NOT OAuth.
# Create a service account in Google Cloud Console, enable the Sheets API and Drive API,
# download its JSON key.
#
# IMPORTANT: service accounts have zero personal Drive storage quota (Google's current
# policy) — they cannot create new files (a new Sheet, a new monthly .xlsx export) unless
# that file lives inside a Google Workspace Shared Drive, where storage is billed to the
# Drive itself. Create a Shared Drive, add the service account's client_email as a member
# (Content Manager), and run `npm run setup:sheet <sharedDriveId> <your-email>` — see README.
GOOGLE_SERVICE_ACCOUNT_JSON=./google-service-account.json
GOOGLE_SHEET_ID=

# Namibia local time is UTC+2 year-round (no DST) — used to compute the
# "previous 24 hours" window and to timestamp rows written to the Sheet.
FLEET_TIMEZONE_OFFSET_MINUTES=120

# --- Monthly reconciliation (syncMonthly.ts) only ---

# Drive file ID of the master "Procon Electrical & Steel Fleet Fuel Tracking System"
# workbook. Must live in Drive (not just local disk) for the cloud Routine to read it.
# The script only ever reads this file — see README "Monthly reconciliation".
MASTER_WORKBOOK_DRIVE_FILE_ID=

# Variance threshold (as a decimal) that flags a vehicle where fleet-card litres and
# Cartrack-metered litres disagree, e.g. 0.05 = 5%.
CARTRACK_VARIANCE_TOLERANCE=0.05

# Optional: Drive folder ID to upload the monthly .xlsx export of the live dashboard into.
# MUST be inside a Shared Drive (see the note above) — a folder in a personal My Drive won't
# work even if shared with the service account, since creating the file itself still needs
# quota. Leave blank to skip the export.
GOOGLE_EXPORT_FOLDER_ID=
